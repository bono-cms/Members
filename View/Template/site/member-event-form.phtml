<script>
document.addEventListener('DOMContentLoaded', function () {
    var parseBtn = document.getElementById('parse-location-btn');
    var urlInput = document.getElementById('map-url-input');
    var latInput = document.getElementById('latitude-input');
    var lngInput = document.getElementById('longitude-input');
    var sourceInput = document.getElementById('location-source-input');
    var parseUrl = <?= json_encode($this->url('Members:Event@parseLocationAction')); ?>;

    parseBtn.addEventListener('click', function () {
        var url = urlInput.value.trim();

        if (!url) {
            return;
        }

        parseBtn.disabled = true;
        parseBtn.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i>';

        fetch(parseUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: 'url=' + encodeURIComponent(url) + '&token=' + encodeURIComponent(document.querySelector('meta[name="csrf-token"]').getAttribute('content'))
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
            parseBtn.disabled = false;
            parseBtn.innerHTML = '<i class="bi bi-arrow-clockwise"></i> <?= $this->translate('Extract'); ?>';

            if (data.error) {
                alert(data.error);
                return;
            }

            latInput.value = data.lat;
            lngInput.value = data.lng;
            sourceInput.value = data.source;
        })
        .catch(function () {
            parseBtn.disabled = false;
            parseBtn.innerHTML = '<i class="bi bi-arrow-clockwise"></i> <?= $this->translate('Extract'); ?>';
        });
    });
});
</script>