<?php

/**
 * Members inbox — server-rendered list of conversations.
 *
 * @var \Krystal\Stdlib\VirtualEntity $page
 * @var array $conversations Output of ChatPresenter::conversations()
 */

?>
<section class="flex-grow-1 d-flex justify-content-center align-items-start py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <h1 class="h3 mb-4">
                    <i class="bi bi-chat-dots"></i>
                    <?= $this->translate('Messages'); ?>
                </h1>

                <?php if (empty($conversations)): ?>
                <div class="text-center py-5">
                    <i class="bi bi-chat-square text-muted empty-state-icon"></i>
                    <p class="text-muted mt-3"><?= $this->translate('No conversations yet.'); ?></p>
                    <a href="<?= $this->url('Members:Directory@indexAction'); ?>" class="btn btn-outline-primary">
                        <i class="bi bi-people"></i>
                        <?= $this->translate('Browse members'); ?>
                    </a>
                </div>
                <?php else: ?>
                <div class="list-group shadow-sm">
                    <?php foreach ($conversations as $conversation): ?>
                    <a href="<?= $this->url('Members:Chat@conversationAction', [$conversation['id']]); ?>" class="list-group-item list-group-item-action d-flex gap-3 align-items-center">
                        <?php if (!empty($conversation['other']['avatar'])): ?>
                        <img src="<?= htmlspecialchars($conversation['other']['avatar']); ?>" class="rounded-circle flex-shrink-0 member-avatar-sm" alt="" />
                        <?php else: ?>
                        <i class="bi bi-person-circle text-secondary flex-shrink-0 member-avatar-icon-sm"></i>
                        <?php endif; ?>

                        <div class="flex-grow-1 min-width-0">
                            <div class="fw-semibold text-truncate"><?= htmlspecialchars($conversation['displayName']); ?></div>
                            <?php if (!empty($conversation['lastMessage'])): ?>
                            <div class="text-muted small text-truncate"><?= htmlspecialchars($conversation['lastMessage']['text']); ?></div>
                            <?php else: ?>
                            <div class="text-muted small fst-italic"><?= $this->translate('No messages yet.'); ?></div>
                            <?php endif; ?>
                        </div>

                        <div class="text-end flex-shrink-0">
                            <?php if (!empty($conversation['lastMessageAt'])): ?>
                            <small class="text-muted d-block"><?= htmlspecialchars(date('M j', strtotime($conversation['lastMessageAt']))); ?></small>
                            <?php endif; ?>
                            <?php if (!empty($conversation['unreadCount'])): ?>
                            <span class="badge bg-primary rounded-pill mt-1"><?= (int) $conversation['unreadCount']; ?></span>
                            <?php endif; ?>
                        </div>
                    </a>
                    <?php endforeach; ?>
                </div>
                <?php endif; ?>
            </div>
        </div>
    </div>
</section>