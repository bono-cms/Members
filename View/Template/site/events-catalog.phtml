<?php

/**
 * Public catalog of approved events
 *
 * @var \Krystal\Stdlib\VirtualEntity $page
 * @var array $events Array of EventEntity objects
 * @var \Krystal\Paginate\PaginatorInterface $paginator
 */

use Krystal\Widget\Pagination\PaginationWidget;

$this->getPluginBag()->load('leaflet');

?>

<style>
    #events-map {
        height: 420px;
    }

    .event-date-box {
        width: 64px;
        height: 64px;
    }

    .event-date-month {
        font-size: 1.5rem;
        line-height: 1;
    }

    .event-date-day {
        font-size: 1.25rem;
        line-height: 1;
    }

    .event-location-name {
        max-width: 150px;
    }

    .event-description-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<section class="flex-grow-1 d-flex justify-content-center align-items-start py-5 bg-light">
    <div class="container">
        <h1 class="h3 mb-4"><i class="bi bi-calendar-event"></i> <?= $this->translate('Events'); ?></h1>

        <!-- Events Map -->
        <div class="card border-0 shadow-sm mb-4 overflow-hidden">
            <div class="card-body p-0">
                <div id="events-map" data-event-map class="w-100"></div>
            </div>
        </div>

        <?php if (empty($events)): ?>
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-calendar text-muted empty-state-icon"></i>
                <h3 class="text-muted mt-3"><?= $this->translate('No events yet'); ?></h3>
                <p class="text-muted"><?= $this->translate('Check back later — new events are added regularly.'); ?></p>
            </div>
        </div>
        <?php else: ?>
        <div class="row g-4">
            <?php foreach ($events as $event): ?>
            <div class="col-12 col-md-6 col-xl-4">
                <a href="<?= $this->url('Members:Event@viewAction', [$event->getId()]); ?>" class="card h-100 text-decoration-none text-body shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-flex flex-column align-items-center justify-content-center flex-shrink-0 event-date-box">
                                <div class="fw-bold event-date-month"><?= $event->getStartMonth(); ?></div>
                                <div class="fw-bold event-date-day"><?= $event->getStartDay(); ?></div>
                            </div>
                            <div class="flex-grow-1 min-width-0">
                                <h2 class="h5 mb-1 text-truncate"><?= htmlspecialchars($event->getTitle()); ?></h2>
                                <p class="text-muted small mb-0">
                                    <i class="bi bi-clock"></i> <?= htmlspecialchars($event->getFormattedTime()); ?>
                                    <?php if ($event->hasLocation()): ?>
                                        &middot; <i class="bi bi-geo-alt"></i> <span class="text-truncate d-inline-block align-middle event-location-name"><?= htmlspecialchars($event->getLocationName()); ?></span>
                                    <?php endif; ?>
                                </p>
                            </div>
                        </div>
                        <?php if ($event->hasDescription()): ?>
                            <p class="text-body-secondary small mb-0 event-description-clamp"><?= htmlspecialchars(mb_substr(strip_tags($event->getDescription()), 0, 150)); ?></p>
                        <?php endif; ?>
                    </div>
                </a>
            </div>
            <?php endforeach; ?>
        </div>
        <div class="mt-4">
            <?= $this->widget(new PaginationWidget($paginator)); ?>
        </div>
        <?php endif; ?>
    </div>
</section>