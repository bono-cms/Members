<?php
$this->getPluginBag()->appendScript('https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js');
?>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary" href="<?= $this->url('Members:Admin:Event@indexAction'); ?>">
        <i class="bi bi-arrow-left"></i> <?= $this->translate('Back to events'); ?>
    </a>
    <h4 class="mb-0"><i class="bi bi-graph-up"></i> <?= htmlspecialchars($event['title']); ?></h4>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase"><?= $this->translate('Views'); ?></div>
                <div class="h2 mb-0"><?= (int) $analytics['views']; ?></div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase"><?= $this->translate('Clicks'); ?></div>
                <div class="h2 mb-0"><?= (int) $analytics['clicks']; ?></div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase"><?= $this->translate('Conversion'); ?></div>
                <div class="h2 mb-0"><?= (float) $analytics['conversion']; ?>%</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <div class="text-muted small text-uppercase"><?= $this->translate('Event date'); ?></div>
                <div class="h6 mb-0"><?= htmlspecialchars(date('M j, Y H:i', strtotime($event['starts_at']))); ?></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-graph-up"></i> <?= $this->translate('Views and clicks over the last 14 days'); ?></h6>
                <canvas id="daily-chart" height="140"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-pie-chart"></i> <?= $this->translate('Traffic sources'); ?></h6>

                <?php if (empty($analytics['sourceStats'])): ?>
                    <p class="text-muted mb-0"><?= $this->translate('No data yet'); ?></p>
                <?php else: ?>
                    <canvas id="source-chart" height="200"></canvas>
                <?php endif; ?>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var dailyStats = <?= json_encode($analytics['dailyStats']); ?>;
    var labels     = dailyStats.map(function (row) { return row.date; });
    var views      = dailyStats.map(function (row) { return row.views; });
    var clicks     = dailyStats.map(function (row) { return row.clicks; });

    new Chart(document.getElementById('daily-chart').getContext('2d'), {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: <?= json_encode($this->translate('Views')); ?>,
                    data: views,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                    fill: true,
                    tension: 0.3
                },
                {
                    label: <?= json_encode($this->translate('Clicks')); ?>,
                    data: clicks,
                    borderColor: '#198754',
                    backgroundColor: 'rgba(25, 135, 84, 0.1)',
                    fill: true,
                    tension: 0.3
                }
            ]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
    });

    <?php if (!empty($analytics['sourceStats'])): ?>
    var sourceStats = <?= json_encode($analytics['sourceStats']); ?>;

    new Chart(document.getElementById('source-chart').getContext('2d'), {
        type: 'pie',
        data: {
            labels: sourceStats.map(function (row) { return row.source; }),
            datasets: [
                {
                    data: sourceStats.map(function (row) { return row.views + row.clicks; }),
                    backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545']
                }
            ]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } }
        }
    });
    <?php endif; ?>
});
</script>