<div class="row g-3" data-event-analytics data-daily-stats="<?= htmlspecialchars(json_encode($analytics['dailyStats']), ENT_QUOTES); ?>" data-source-stats="<?= htmlspecialchars(json_encode($analytics['sourceStats']), ENT_QUOTES); ?>" data-translations="<?= htmlspecialchars(json_encode(['views' => $this->translate('Views'), 'clicks' => $this->translate('Clicks')]), ENT_QUOTES); ?>">
