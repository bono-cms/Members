<?php

use Krystal\Form\Element;
use Krystal\Date\TimeHelper;

$this->getPartialBag()->addPartialDir(__DIR__ . '/partials');

/**
 * Renders a translated relative-time string for a given timestamp
 *
 * @param string $timestamp
 * @return string
 */
$renderRelativeTime = function ($timestamp) {
    $parts = TimeHelper::relativeTimePattern($timestamp);

    if ($parts['pattern'] === '') {
        return '';
    }

    if ($parts['value'] === null) {
        return $this->translate($parts['pattern']);
    }

    return $this->translate(sprintf($parts['pattern'], $parts['value']));
};

