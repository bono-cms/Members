/**
 * datetime-local inputs accept "Y-m-d\TH:i" only; the entity stores
 * "Y-m-d H:i:s". Without this the edit form shows empty dates.
 */
$toLocalInput = function ($value) {
    if (empty($value)) {
        return '';
    }

    $timestamp = strtotime($value);

    return $timestamp === false ? '' : date('Y-m-d\TH:i', $timestamp);
};

$startsAtValue = $toLocalInput($entity->getStartsAt());
$endsAtValue   = $toLocalInput($entity->getEndsAt());

