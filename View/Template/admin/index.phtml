<?php

use Krystal\Iso\ISO3166\Country;
use Krystal\Form\Element;
use Krystal\Date\TimeHelper;
use Krystal\Widget\GridView\GridViewWidget;
use Cms\View\Icon;
use Members\Service\MemberEntity;

?>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <a class="btn btn-primary" href="<?= $this->url('Members:Admin:Members@addAction'); ?>">
        <i class="bi bi-person-plus"></i> <?= $this->translate('Add new member'); ?>
    </a>

    <div class="d-flex flex-wrap gap-2">
        <?php $pendingCount = isset($pendingCount) ? (int) $pendingCount : 0; ?>

        <?php if ($pendingCount > 0): ?>
        <a class="btn btn-danger" href="<?= $this->url('Members:Admin:Changes@indexAction'); ?>">
            <i class="bi bi-hourglass-split"></i> <?= $this->translate('Pending changes'); ?> <span class="badge bg-light text-danger ms-1">+<?= $pendingCount; ?></span>
        </a>
        <?php else: ?>
        <a class="btn btn-primary" href="<?= $this->url('Members:Admin:Changes@indexAction'); ?>">
            <i class="bi bi-hourglass-split"></i> <?= $this->translate('Pending changes'); ?>
        </a>
        <?php endif; ?>

        <a class="btn btn-info" href="<?= $this->url('Members:Admin:TagGroup@indexAction'); ?>">
            <i class="bi bi-tags"></i> <?= $this->translate('Manage tags'); ?>
        </a>
    </div>
</div>

<div class="card">
    <?php $this->loadPartial('items-per-page', ['caption' => 'Members']); ?>

    <div class="table-responsive">
        <?= $this->widget(new GridViewWidget($members, [
            'tableClass' => 'table table-hover table-bordered table-striped align-middle',
            'rowAttributes' => [
                'class' => function ($member) {
                    return $member->getConfirmed() ? null : 'table-warning';
                }
            ],
            'columns' => [
                [
                    'column' => 'avatar',
                    'label' => 'Avatar',
                    'value' => function ($member) {
                        if ($member->hasAvatar()) {
                            return '<img src="' . $member->getAvatarUrl(MemberEntity::AVATAR_THUMB) . '" class="rounded-circle img-fluid" alt="">';
                        }

                        return '<i class="bi bi-person-circle text-muted" style="font-size:28px;"></i>';
                    }
                ],

                [
                    'column' => 'name',
                    'label' => 'Member',
                    'value' => function ($member) {
                        $name = htmlspecialchars((string) $member->getName());
                        if ($name === '') {
                            $name = '<em class="text-muted">' . $this->translate('Unnamed') . '</em>';
                        }

                        return $name;
                    }
                ],

                [
                    'column' => 'email',
                    'value' => function ($member) {
                        $email = (string) $member->getEmail();
                        return Element::linkEmail($email);
                    }
                ],

                [
                    'column' => 'country',
                    'value' => function ($member) {
                        $code = $member->getCountry();
                        if (!$code) {
                            return '—';
                        }

                        return (new Country())->getCountryByCode($code);
                    }
                ],

                [
                    'column' => 'confirmed',
                    'label' => 'Status',
                    'value' => function ($member) {
                        if ($member->getConfirmed()) {
                            return '<span class="badge bg-success">'
                                 . $this->translate('Confirmed')
                                 . '</span>';
                        }
                        return '<span class="badge bg-warning text-dark">'
                             . $this->translate('Unconfirmed')
                             . '</span>';
                    }
                ],

                [
                    'column' => 'created_at',
                    'label' => 'Joined',
                    'value' => function ($member) {
                        $ts = $member->getCreatedAt();
                        if (!$ts) {
                            return '—';
                        }

                        return TimeHelper::formatLocalized(
                            $ts,
                            null,
                            'MMM d, yyyy'
                        );
                    }
                ]
            ],

            'actions' => [
                function ($member) {
                    return Icon::edit(
                        $this->url('Members:Admin:Members@editAction', $member->getId()),
                        $this->translate('Edit this member')
                    );
                },

                function ($member) {
                    return Icon::button('bi bi-clock-history', $this->url('Members:Admin:Members@historyAction', $member->getId()), $this->translate('View change history'));
                },

                function ($member) {
                    return Icon::remove(
                        $this->url('Members:Admin:Members@deleteAction', $member->getId()),
                        $this->translate('Remove this member')
                    );
                }
            ]
        ])); ?>

        <?php if (empty($members)): ?>
        <div class="text-center py-5">
            <i class="bi bi-people text-muted" style="font-size:3rem;"></i>
            <h3 class="text-muted mt-3"><?= $this->translate('No members yet'); ?></h3>
            <p class="text-muted"><?= $this->translate('Get started by adding your first member.'); ?></p>
            <a class="btn btn-primary mt-2" href="<?= $this->url('Members:Admin:Members@addAction'); ?>">
                <i class="bi bi-person-plus"></i> <?= $this->translate('Add new member'); ?>
            </a>
        </div>
        <?php endif; ?>
    </div>

    <div class="pt-3">
        <?php $this->loadPartial('paginator'); ?>
    </div>
</div>