<?php

use Krystal\Form\Element;

$isNew = !$group->getId();

?>

<form class="card" autocomplete="off">
    <?= Element::hidden('group[id]', $group->getId()); ?>

    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
            <li class="nav-item"><a class="nav-link active" href="#main" data-bs-toggle="tab"><?= $this->translate('Main'); ?></a></li>
            <?php foreach ($languages as $language): ?>
            <li class="nav-item"><a class="nav-link" href="#language-<?= $language->getId(); ?>" data-bs-toggle="tab"><?= $language->getName(); ?></a></li>
            <?php endforeach; ?>
        </ul>
    </div>

    <div class="card-body tab-content">
        <div class="tab-pane fade show active" id="main" role="tabpanel">
            <div class="row mb-3">
                <label class="col-lg-2 col-form-label"><?= $this->translate('Code'); ?></label>
                <div class="col-lg-10">
                    <?= Element::text('group[code]', $group->getCode(), ['class' => 'form-control', 'placeholder' => 'e.g. interests', 'required' => true]); ?>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-lg-2 col-form-label"><?= $this->translate('Sort order'); ?></label>
                <div class="col-lg-10">
                    <?= Element::number('group[sort_order]', $group->getSortOrder() ?: 0, ['class' => 'form-control']); ?>
                </div>
            </div>
        </div>

        <?php foreach ($languages as $language): ?>
        <?php
        $langId = $language->getId();
        $row = isset($translations[$langId]) ? $translations[$langId] : [];
        ?>
        <div class="tab-pane fade" id="language-<?= $langId; ?>" role="tabpanel">
            <div class="row mb-3">
                <label class="col-lg-2 col-form-label"><?= $this->translate('Name'); ?></label>
                <div class="col-lg-10">
                    <?= Element::text(sprintf('translation[%s][name]', $langId), isset($row['name']) ? $row['name'] : '', ['class' => 'form-control', 'required' => true]); ?>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-lg-2 col-form-label"><?= $this->translate('Description'); ?></label>
                <div class="col-lg-10">
                    <?= Element::text(sprintf('translation[%s][description]', $langId), isset($row['description']) ? $row['description'] : '', ['class' => 'form-control']); ?>
                </div>
            </div>
        </div>
        <?php endforeach; ?>
    </div>

    <?php $this->loadPartial('actions', [
        'new' => $isNew,
        'add' => 'Members:Admin:TagGroup@addAction',
        'edit' => 'Members:Admin:TagGroup@editAction',
        'save' => 'Members:Admin:TagGroup@saveAction',
        'cancel' => 'Members:Admin:TagGroup@indexAction'
    ]); ?>
</form>